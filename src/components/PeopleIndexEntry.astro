---
import { withBase } from '../utils/paths';
const { entry } = Astro.props;
const d = entry.data;
const photo = d.photo ? (/^https?:\/\//.test(d.photo) ? d.photo : withBase(d.photo)) : '';
---
<article class="index-entry" data-index-entry><div class="index-summary"><button class="index-fields people-fields" type="button" data-index-toggle aria-expanded="false"><span class="index-cell">{d.name}</span><span class="index-cell">{d.title}</span><span class="index-cell">{d.institution}</span></button><span class="index-action-spacer" aria-hidden="true"></span><button class="index-action expand" type="button" data-index-toggle data-expand-button aria-expanded="false" aria-label="Expand details">+</button></div><div class="index-detail-wrap" data-index-detail aria-hidden="true"><div class="index-detail-clip"><div class="index-detail"><div class="people-detail">{photo && <img class="people-photo" src={photo} alt={d.photoAlt || `Portrait of ${d.name}`} loading="lazy" />}<div class="people-bio"><div class="detail-block"><span class="detail-label">Bio</span><div class="detail-text" set:html={d.bio}></div></div>{(d.email || d.cv || d.cvFile || d.links?.length) && <div class="detail-links">{d.email && <a href={d.email}>Email</a>}{d.cvFile && <a href={/^https?:\/\//.test(d.cvFile) ? d.cvFile : withBase(d.cvFile)} target="_blank" rel="noopener">CV</a>}{!d.cvFile && d.cv && <a href={d.cv} target="_blank" rel="noopener">CV</a>}{d.links?.map((link:any) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}</div>}</div></div></div></div></div></article>
