---
interface Props {
  heading?: string;
  agentLabel?: string;
  discoveryLabel?: string;
  validateLabel?: string;
  noChangeLabel?: string;
  changeLabel?: string;
  researchLogLabel?: string;
  humanReviewLabel?: string;
  humanReviewDetail?: string;
  publicAtlasLabel?: string;
}

const {
  heading = 'Agent-assisted research with human review',
  agentLabel = 'Agent-assisted research and reconciliation',
  discoveryLabel = 'Discovery and Research',
  validateLabel = 'Validate and Reconcile',
  noChangeLabel = 'No material change',
  changeLabel = 'New record or change identified',
  researchLogLabel = 'Research log',
  humanReviewLabel = 'Human Review',
  humanReviewDetail = 'Verify sources, record identity, and proposed changes against evidence.',
  publicAtlasLabel = 'Public Atlas'
} = Astro.props;
---

<section class="module module-research-workflow" data-module-type="research-workflow" data-research-workflow>
  {heading && <h3 class="research-workflow-heading">{heading}</h3>}

  <div class="research-workflow-inner">
    <div class="research-workflow-wrap" data-workflow-wrap>
      <svg class="research-workflow-lines" data-workflow-svg aria-hidden="true"></svg>

      <div class="research-workflow-layout">
        <section class="research-workflow-agent" data-node="agent" aria-label={agentLabel}>
          <span class="research-workflow-agent-label">{agentLabel}</span>
          <div class="research-workflow-node" data-node="discovery">{discoveryLabel}</div>
          <div class="research-workflow-node" data-node="validate">{validateLabel}</div>
        </section>

        <div class="research-workflow-node" data-node="nochange">{noChangeLabel}</div>
        <div class="research-workflow-node" data-node="change">{changeLabel}</div>

        <div class="research-workflow-end" data-node="log">{researchLogLabel}</div>
        <div class="research-workflow-node research-workflow-node--human" data-node="human">
          <span class="research-workflow-human-title">{humanReviewLabel}</span>
          {humanReviewDetail && <span class="research-workflow-human-detail">{humanReviewDetail}</span>}
        </div>

        <div class="research-workflow-end" data-node="publish">{publicAtlasLabel}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .module-research-workflow {
    overflow: visible;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .research-workflow-heading {
    width: 100%;
    max-width: 720px;
    margin: 0 0 24px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 12pt;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -.005em;
    text-align: left;
  }

  .research-workflow-inner {
    width: min(100%, 520px);
    margin: 0 auto;
  }

  .research-workflow-wrap {
    position: relative;
    width: 100%;
  }

  .research-workflow-lines {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .research-workflow-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "agent agent"
      "nochange change"
      "log human"
      ". publish";
    column-gap: 22px;
    row-gap: 22px;
    align-items: start;
    justify-items: center;
  }

  .research-workflow-agent {
    grid-area: agent;
    position: relative;
    width: min(100%, 300px);
    padding: 15px 13px 12px;
    border: 1px dashed var(--line);
    border-radius: 7px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    background: transparent;
  }

  .research-workflow-agent-label {
    position: absolute;
    top: -8px;
    left: 11px;
    padding: 0 5px;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 8.5pt;
    font-style: italic;
    font-weight: 400;
    line-height: 1.15;
    white-space: nowrap;
  }

  .research-workflow-node,
  .research-workflow-end {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 9pt;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
  }

  .research-workflow-node {
    min-height: 34px;
    padding: 6px 9px;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .research-workflow-node--human {
    flex-direction: column;
    gap: 3px;
    padding-top: 7px;
    padding-bottom: 7px;
  }

  .research-workflow-human-title {
    font-weight: 700;
  }

  .research-workflow-human-detail {
    max-width: 185px;
    color: var(--muted);
    font-size: 7.7pt;
    font-weight: 400;
    line-height: 1.25;
  }

  .research-workflow-end {
    min-height: 24px;
    padding: 2px 6px;
  }

  [data-node="nochange"] { grid-area: nochange; }
  [data-node="change"] { grid-area: change; }
  [data-node="log"] { grid-area: log; }
  [data-node="human"] { grid-area: human; }
  [data-node="publish"] { grid-area: publish; }

  /* When this module sits between text modules, treat all three as one
     continuous section. This follows module order in Pages CMS automatically. */
  :global(.module[data-module-type="text"]:has(+ .module-research-workflow)) {
    padding-bottom: 12px;
    border-bottom: 0;
  }

  :global(.module[data-module-type="text"] + .module-research-workflow) {
    padding-top: 8px;
  }

  :global(.module-research-workflow:has(+ .module[data-module-type="text"])) {
    padding-bottom: 0;
    border-bottom: 0;
  }

  :global(.module-research-workflow + .module[data-module-type="text"]) {
    padding-top: 6px;
  }

  @media (max-width: 560px) {
    .research-workflow-heading {
      margin-bottom: 22px;
      font-size: 12pt;
    }

    .research-workflow-inner {
      width: min(100%, 430px);
    }

    .research-workflow-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "agent agent"
        "nochange change"
        "log human"
        ". publish";
      column-gap: 10px;
      row-gap: 19px;
    }

    .research-workflow-agent {
      width: min(100%, 275px);
      padding: 14px 10px 11px;
      gap: 13px;
    }

    .research-workflow-agent-label {
      left: 9px;
      max-width: calc(100% - 18px);
      font-size: 7.8pt;
      white-space: nowrap;
    }

    .research-workflow-node,
    .research-workflow-end {
      max-width: none;
      font-size: 8.25pt;
    }

    .research-workflow-node {
      min-height: 38px;
      padding: 6px;
    }

    .research-workflow-human-detail {
      max-width: 150px;
      font-size: 7.15pt;
    }

    .research-workflow-end {
      min-height: 22px;
      padding: 2px 3px;
    }
  }

  @media (max-width: 360px) {
    .research-workflow-layout {
      column-gap: 7px;
      row-gap: 18px;
    }

    .research-workflow-node,
    .research-workflow-end {
      font-size: 7.8pt;
    }

    .research-workflow-node {
      padding-right: 4px;
      padding-left: 4px;
    }

    .research-workflow-human-detail {
      font-size: 6.9pt;
    }

    .research-workflow-agent-label {
      font-size: 7.4pt;
    }
  }
</style>

<script>
  const workflowLinks = [
    ['discovery', 'validate', 'vertical'],
    ['validate', 'nochange', 'branch'],
    ['validate', 'change', 'branch'],
    ['nochange', 'log', 'vertical'],
    ['change', 'human', 'vertical'],
    ['human', 'publish', 'vertical']
  ];

  const boundWorkflows = new WeakSet<Element>();

  function bindResearchWorkflow(root: Element) {
    if (boundWorkflows.has(root)) return;
    boundWorkflows.add(root);

    const wrap = root.querySelector<HTMLElement>('[data-workflow-wrap]');
    const svg = root.querySelector<SVGSVGElement>('[data-workflow-svg]');
    if (!wrap || !svg) return;

    const node = (name: string) => root.querySelector<HTMLElement>(`[data-node="${name}"]`);

    const rectFor = (name: string, wrapRect: DOMRect) => {
      const el = node(name);
      if (!el) return null;
      const rect = el.getBoundingClientRect();
      return {
        top: rect.top - wrapRect.top,
        bottom: rect.bottom - wrapRect.top,
        cx: rect.left - wrapRect.left + rect.width / 2
      };
    };

    const pathEl = (d: string, color: string) => {
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', d);
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', color);
      path.setAttribute('stroke-width', '1');
      path.setAttribute('vector-effect', 'non-scaling-stroke');
      path.setAttribute('stroke-linecap', 'round');
      path.setAttribute('stroke-linejoin', 'round');
      return path;
    };

    const triangle = (x: number, y: number, color: string) => {
      const marker = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      marker.setAttribute('points', `${x},${y} ${x - 4},${y - 6} ${x + 4},${y - 6}`);
      marker.setAttribute('fill', color);
      return marker;
    };

    const branchPath = (a: {x:number;y:number}, b: {x:number;y:number}, groupBottom: number) => {
      if (Math.abs(b.x - a.x) < 1) return `M ${a.x} ${a.y} V ${b.y - 6}`;

      const radius = 6;
      const direction = b.x >= a.x ? 1 : -1;
      const desiredGap = 6;
      const minMidY = groupBottom + desiredGap;
      const maxMidY = b.y - 12;
      const naturalMidY = a.y + Math.max(9, Math.min(13, (b.y - a.y) * 0.42));
      const midY = Math.min(maxMidY, Math.max(minMidY, naturalMidY));
      const r = Math.min(radius, Math.abs(b.x - a.x) / 3, Math.max(3, (b.y - midY - 6) / 2));

      return [
        `M ${a.x} ${a.y}`,
        `V ${midY - r}`,
        `Q ${a.x} ${midY} ${a.x + direction * r} ${midY}`,
        `H ${b.x - direction * r}`,
        `Q ${b.x} ${midY} ${b.x} ${midY + r}`,
        `V ${b.y - 6}`
      ].join(' ');
    };

    let frame = 0;
    const draw = () => {
      const wrapRect = wrap.getBoundingClientRect();
      const agentRect = rectFor('agent', wrapRect);
      if (!agentRect) return;

      const color = getComputedStyle(root).getPropertyValue('--line').trim() || '#c8cbcc';
      svg.setAttribute('viewBox', `0 0 ${wrapRect.width} ${wrapRect.height}`);
      svg.replaceChildren();

      for (const [fromName, toName, type] of workflowLinks) {
        const from = rectFor(fromName, wrapRect);
        const to = rectFor(toName, wrapRect);
        if (!from || !to) continue;

        const a = { x: from.cx, y: from.bottom };
        const b = { x: to.cx, y: to.top };
        const d = type === 'branch'
          ? branchPath(a, b, agentRect.bottom)
          : `M ${a.x} ${a.y} V ${b.y - 6}`;

        svg.append(pathEl(d, color), triangle(b.x, b.y, color));
      }
    };

    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(draw);
    };

    window.addEventListener('resize', schedule, { passive: true });
    new ResizeObserver(schedule).observe(wrap);
    document.fonts?.ready.then(schedule).catch(schedule);
    schedule();
  }

  document.querySelectorAll('[data-research-workflow]').forEach(bindResearchWorkflow);
</script>
