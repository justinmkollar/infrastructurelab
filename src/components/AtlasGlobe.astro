---
import { withBase } from '../utils/paths';
interface Props {
  buttonLabel?: string;
  buttonUrl?: string;
  intro?: string;
}
const { buttonLabel = 'Open the Atlas of Data Center Politics', buttonUrl = '#', intro = '' } = Astro.props;
const href = /^https?:\/\//.test(buttonUrl) || buttonUrl === '#' ? buttonUrl : withBase(buttonUrl);
---
<section class="project-hero atlas-hero">
  <div class="atlas-splash" aria-hidden="true">
    <div class="globe-stage">
      <canvas id="globeCanvas" class="globe-canvas" data-globe-data={withBase('/data/atlas-globe-data.json')}></canvas>
    </div>
  </div>
  <div class="project-launch"><a href={href}>{buttonLabel}</a></div>
  {intro && <p class="project-intro">{intro}</p>}
</section>
<script>import '../scripts/atlas-globe.js';</script>
