---
import { withBase } from '../utils/paths';
const { entry } = Astro.props;
const d = entry.data;
const goto = withBase(`/people/positions/${entry.id}/`);
---
<article class="index-entry" data-index-entry>
  <div class="index-summary">
    <button class="index-fields position-fields" type="button" data-index-toggle aria-expanded="false">
      <span class="index-cell">{d.title}</span>
      <span class="index-cell end">{d.dateLabel}</span>
    </button>
    <a class="index-action goto" href={goto} aria-label={`Open ${d.title}`}>→</a>
    <button class="index-action expand" type="button" data-index-toggle data-expand-button aria-expanded="false" aria-label="Expand details">+</button>
  </div>
  <div class="index-detail-wrap" data-index-detail aria-hidden="true">
    <div class="index-detail-clip">
      <div class="index-detail">
        <div class="detail-block">
          <span class="detail-label">Description</span>
          <div class="detail-text" set:html={d.description}></div>
        </div>
        <div class="detail-links"><a href={goto}>View position</a></div>
      </div>
    </div>
  </div>
</article>
