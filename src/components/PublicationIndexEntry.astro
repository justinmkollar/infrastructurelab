---
const { entry } = Astro.props;
const d = entry.data;
---
<article class="index-entry" data-index-entry><div class="index-summary"><button class="index-fields publication-fields" type="button" data-index-toggle aria-expanded="false"><span class="index-cell">{d.authors.join(', ')}</span><span class="index-cell">{d.title}</span><span class="index-cell">{d.details}</span><span class="index-cell">{d.type}</span></button>{d.url ? <a class="index-action goto" href={d.url} target="_blank" rel="noopener" aria-label={`Open ${d.title} in a new window`}>→</a> : <span class="index-action-spacer" aria-hidden="true"></span>}<button class="index-action expand" type="button" data-index-toggle data-expand-button aria-expanded="false" aria-label="Expand details">+</button></div><div class="index-detail-wrap" data-index-detail aria-hidden="true"><div class="index-detail-clip"><div class="index-detail"><div class="detail-block"><span class="detail-label">Abstract</span><div class="detail-text" set:html={d.abstract}></div></div>{d.keywords?.length > 0 && <div class="detail-block"><span class="detail-label">Keywords</span><div class="detail-text">{d.keywords.join(' · ')}</div></div>}</div></div></div></article>
