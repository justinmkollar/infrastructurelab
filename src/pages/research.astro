---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchIndexEntry from '../components/ResearchIndexEntry.astro';
import { sortByDisplayOrder } from '../utils/contentOrder';

const entries = sortByDisplayOrder(
  await getCollection('research', ({ data }) => data.published),
  'research',
  (entry) => entry.data.title
);
---
<BaseLayout title="Research" active="Research"><main class="page"><section class="page-section"><div class="content-narrow"><h1>Research</h1><p>Research projects, datasets, atlases, and other public-facing work.</p></div><div class="index-list">{entries.map((entry) => <ResearchIndexEntry entry={entry} />)}</div></section></main></BaseLayout>
