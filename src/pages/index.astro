---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import { withBase } from '../utils/paths';
const fadeMs = Math.max(0, Number(site.home.splashFadeSeconds || 2) * 1000);
const holdMs = Math.max(fadeMs + 500, Number(site.home.splashHoldSeconds || 30) * 1000);
type SplashImage = {
  type: 'image'; image: string; alt?: string; focalX?: number; focalY?: number;
  motion?: 'none' | 'zoom-in' | 'zoom-out' | 'pan-left' | 'pan-right' | 'pan-up' | 'pan-down';
  zoomPercent?: number; panPercent?: number;
};
type SplashItem = SplashImage
  | { type: 'video'; video: string; poster: string; playbackRate?: number; displaySeconds?: number; focalX?: number; focalY?: number };
const splashMedia = site.home.splashMedia as unknown as SplashItem[];

// Constrain CMS values before including them in CSS custom properties.
const clampMotionValue = (value: number | undefined, fallback: number, min: number, max: number) => {
  const number = value === undefined || value === null ? fallback : Number(value);
  return Number.isFinite(number) ? Math.max(min, Math.min(max, number)) : fallback;
};
const hasImageMotion = (item: SplashImage) =>
  ['zoom-in', 'zoom-out', 'pan-left', 'pan-right', 'pan-up', 'pan-down'].includes(item.motion ?? 'none');

function imageMotionStyle(item: SplashImage): string {
  const focalX = clampMotionValue(item.focalX, 50, 0, 100);
  const focalY = clampMotionValue(item.focalY, 50, 0, 100);
  const zoom = clampMotionValue(item.zoomPercent, 3, 0.5, 5);
  const pan = clampMotionValue(item.panPercent, 1, 0.25, 3);
  let startScale = 1.004, endScale = 1.004;
  let startX = 0, endX = 0, startY = 0, endY = 0;
  switch (item.motion) {
    case 'zoom-in':
      startScale = 1; endScale = 1 + zoom / 100;
      break;
    case 'zoom-out':
      startScale = 1 + zoom / 100; endScale = 1;
      break;
    case 'pan-left':
    case 'pan-right':
    case 'pan-up':
    case 'pan-down': {
      // 1% extra scaling allows at least 0.5% safety margin per side.
      const scale = 1 + (pan + 1) / 100;
      const half = pan / 2;
      startScale = endScale = scale;
      if (item.motion === 'pan-left') { startX = half; endX = -half; }
      if (item.motion === 'pan-right') { startX = -half; endX = half; }
      if (item.motion === 'pan-up') { startY = half; endY = -half; }
      if (item.motion === 'pan-down') { startY = -half; endY = half; }
      break;
    }
  }
  return [
    `object-position:${focalX}% ${focalY}%`,
    `--motion-from-x:${startX}%`, `--motion-to-x:${endX}%`,
    `--motion-from-y:${startY}%`, `--motion-to-y:${endY}%`,
    `--motion-from-scale:${startScale}`, `--motion-to-scale:${endScale}`
  ].join(';');
}
---
<BaseLayout title={site.title} active="About" bodyClass="home-page">
  <main>
    <section
      class="home-splash"
      data-splash
      data-fade-ms={fadeMs}
      data-hold-ms={holdMs}
      style={`--splash-fade:${site.home.splashFadeSeconds || 2}s;--splash-motion-duration:${(holdMs + 2 * fadeMs) / 1000}s`}
      aria-label="Infrastructure landscape"
    >
      {splashMedia.map((item) =>
        item.type === 'video'
          ? <video
              class="splash-layer"
              muted
              playsinline
              loop
              preload="metadata"
              poster={item.poster ? withBase(item.poster) : undefined}
              data-playback-rate={item.playbackRate ?? 1}
              data-display-ms={item.displaySeconds ? item.displaySeconds * 1000 : undefined}
              style={`object-position:${item.focalX ?? 50}% ${item.focalY ?? 50}%`}
              aria-hidden="true"
            >
              <source src={withBase(item.video)} type={item.video.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
            </video>
          : <img
              class={`splash-layer splash-image${hasImageMotion(item) ? ' has-motion' : ''}`}
              src={withBase(item.image)}
              alt={item.alt || ''}
              style={imageMotionStyle(item)}
              aria-hidden="true"
            />
      )}
    </section>
    <script is:inline>
      // Choose the first visible splash during HTML parsing so a static GitHub
      // Pages build can still start on a different image on every page load.
      // The selected image is shown immediately; the main controller handles
      // only subsequent crossfades.
      (() => {
        const splash = document.querySelector('[data-splash]');
        const layers = splash ? [...splash.querySelectorAll('.splash-layer')] : [];
        if (!layers.length) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const options = reduceMotion
          ? layers.map((layer, index) => layer.tagName === 'IMG' ? index : -1).filter(index => index >= 0)
          : layers.map((_, index) => index);
        const active = options[Math.floor(Math.random() * options.length)] ?? 0;
        layers[active].classList.add('is-initial', 'is-visible');
        if (layers[active].classList.contains('has-motion')) layers[active].classList.add('is-motion-active');
        layers[active].style.transition = 'none';
        splash.dataset.initialSplash = String(active);
      })();
    </script>
    <div class="page">
      <section class="page-section home-about">
        <div class="content-narrow">
          <h1>{site.home.heading}</h1>
          <p class="lead">{site.home.lead}</p>
          <div class="rich-text" set:html={site.home.body}></div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
