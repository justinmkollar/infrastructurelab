---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PeopleIndexEntry from '../components/PeopleIndexEntry.astro';
import PositionIndexEntry from '../components/PositionIndexEntry.astro';
import { sortByDisplayOrder } from '../utils/contentOrder';

const entries = sortByDisplayOrder(
  await getCollection('people', ({ data }) => data.published),
  'people',
  (entry) => entry.data.name
);

const positions = sortByDisplayOrder(
  await getCollection('positions', ({ data }) => data.published),
  'positions',
  (entry) => entry.data.title
);
---
<BaseLayout title="People" active="People">
  <main class="page">
    <section class="page-section">
      <div class="content-narrow"><h1>People</h1></div>
      <div class="index-list">{entries.map((entry) => <PeopleIndexEntry entry={entry} />)}</div>
    </section>

    {positions.length > 0 && <section class="page-section">
      <div class="content-narrow"><h1>Open Positions</h1></div>
      <div class="index-list">{positions.map((entry) => <PositionIndexEntry entry={entry} />)}</div>
    </section>}
  </main>
</BaseLayout>
