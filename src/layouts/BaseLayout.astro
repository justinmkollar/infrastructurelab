---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import projectPalettes from '../data/project-palettes.json';

const colorKeys = [
  'lightBackground', 'lightText', 'lightMuted', 'lightSmall', 'lightLine', 'lightSoft',
  'darkBackground', 'darkText', 'darkMuted', 'darkSmall', 'darkLine', 'darkSoft'
] as const;

type ColorKey = typeof colorKeys[number];
type ThemeColors = Partial<Record<ColorKey, string>>;
interface Theme extends ThemeColors {
  preset?: string;
  overrides?: ThemeColors;
}

// A preset is the base; individually supplied custom colors override it.
// If no preset is chosen, legacy project colors (or global defaults) apply.
const validColors = (value?: ThemeColors): ThemeColors => {
  const colors: ThemeColors = {};
  for (const key of colorKeys) {
    const color = value?.[key];
    if (typeof color === 'string' && /^#[0-9a-fA-F]{6}$/.test(color)) {
      colors[key] = color;
    }
  }
  return colors;
};

interface Props {
  title?: string;
  description?: string;
  active?: string;
  bodyClass?: string;
  projectTheme?: Theme;
}

const {
  title = site.title,
  description = site.siteDescription,
  active = '',
  bodyClass = '',
  projectTheme
} = Astro.props;

const globalTheme = site.theme as Theme;
const namedPresets = projectPalettes as Record<string, ThemeColors>;
const selectedPreset = projectTheme?.preset && Object.prototype.hasOwnProperty.call(namedPresets, projectTheme.preset)
  ? namedPresets[projectTheme.preset]
  : undefined;
const mergedProjectTheme = {
  ...globalTheme,
  ...validColors(selectedPreset || projectTheme),
  ...validColors(projectTheme?.overrides)
};

const globalLightSmall = globalTheme.lightSmall || '#7b7b7b';
const globalLightSoft = globalTheme.lightSoft || `color-mix(in srgb,${globalTheme.lightText} 5%,${globalTheme.lightBackground})`;
const globalDarkSmall = globalTheme.darkSmall || '#a2a2a2';
const globalDarkSoft = globalTheme.darkSoft || `color-mix(in srgb,${globalTheme.darkText} 5%,${globalTheme.darkBackground})`;

const rootThemeCss = `:root{--bg:${globalTheme.lightBackground};--fg:${globalTheme.lightText};--muted:${globalTheme.lightMuted};--small:${globalLightSmall};--line:${globalTheme.lightLine};--soft:${globalLightSoft};}:root[data-theme="dark"]{--bg:${globalTheme.darkBackground};--fg:${globalTheme.darkText};--muted:${globalTheme.darkMuted};--small:${globalDarkSmall};--line:${globalTheme.darkLine};--soft:${globalDarkSoft};}`;

let projectThemeCss = '';
if (projectTheme) {
  const projectLightSmall = projectTheme.lightSmall || '#7d8183';
  const projectLightSoft = projectTheme.lightSoft || `color-mix(in srgb,${mergedProjectTheme.lightText} 5%,${mergedProjectTheme.lightBackground})`;
  const projectDarkSmall = projectTheme.darkSmall || '#8d9395';
  const projectDarkSoft = projectTheme.darkSoft || `color-mix(in srgb,${mergedProjectTheme.darkText} 5%,${mergedProjectTheme.darkBackground})`;

  // Project palettes are scoped to the project page itself, matching the
  // original prototype. This prevents the global site palette from winning
  // the cascade while keeping every value editable through the Research CMS.
  projectThemeCss = `body.project-page{--bg:${mergedProjectTheme.lightBackground};--fg:${mergedProjectTheme.lightText};--muted:${mergedProjectTheme.lightMuted};--small:${projectLightSmall};--line:${mergedProjectTheme.lightLine};--soft:${projectLightSoft};}:root[data-theme="dark"] body.project-page{--bg:${mergedProjectTheme.darkBackground};--fg:${mergedProjectTheme.darkText};--muted:${mergedProjectTheme.darkMuted};--small:${projectDarkSmall};--line:${mergedProjectTheme.darkLine};--soft:${projectDarkSoft};}`;
}

const themeCss = `${rootThemeCss}${projectThemeCss}`;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VZGCPN54VG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-VZGCPN54VG');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title === site.title ? site.title : `${title} — ${site.title}`}</title>
    <style is:inline set:html={themeCss}></style>
  </head>
  <body class={bodyClass}>
    <Header active={active} />
    <slot />
    <Footer />
    <script>import '../scripts/site.js';</script>
  </body>
</html>
